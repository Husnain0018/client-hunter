# Environment configuration for Client Hunter Backend
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# Security keys (Must be changed in production: AUTH_SECRET min 32 chars)
AUTH_SECRET=your-32-character-secret-key-goes-here-min32
AUTH_TOKEN_EXPIRES_IN=30d
CLIENT_HUNTER_ACCESS_CODE=your-secure-access-code

# Persistent SQLite database path
DATABASE_PATH=./data/client-hunter.sqlite

# Baileys WhatsApp configuration (Direct integration, no WAHA or paid gateway required)
BAILEYS_SESSION_DIR=./data/baileys_auth
BAILEYS_LOG_LEVEL=warn

# Optional live Google Maps / social lead discovery (Apify)
APIFY_API_TOKEN=

# Optional AI analysis (OpenAI-compatible endpoint, e.g. OpenAI or Gemini OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional SMTP email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google Sheets export
GOOGLE_SHEETS_ACCESS_TOKEN=
